-        "        # else:\n",
-        "        #   reward=0\n",
-        "        # Record current objective integrand for next evaluatio\n",
-        "        reward = -(objective_integrand - self.objective_integrand)\n",
-        "        self.objective_integrand = objective_integrand\n",
-        "        return reward"
